rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The school's own data (staff sign-in required):
    // settings, secrets, branding, alerts, and data/<collection>/<id>
    // (students, fees, payments, expenses, exams, attendance).
    // This one rule also covers the old single document ikhlas_school/main.
    match /ikhlas_school/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Parent Portal app: one parent-safe summary per student.
    // The document ID (Admission No. + date of birth) acts as the parent's key.
    match /parent_portal/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }
    match /parent_portal_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /notifications/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Shared Firebase usage meter shown in Settings. Keep this if your current rules already have it.
    match /usage_meter/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
